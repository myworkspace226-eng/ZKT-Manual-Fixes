@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion
cd /d "%~dp0"
title ZKT Biometric - Windows Desktop Builder

cls
echo ===============================================================================
echo        نظام إدارة البصمة ZKT Biometric - أداة بناء برنامج الديسكتوب (EXE)
echo ===============================================================================
echo.

REM --- فحص 1: التحقق من فك ضغط المجلد ---
if not exist "package.json" goto ERROR_ZIP

REM --- فحص 2: التحقق من وجود Node.js على الجهاز ---
echo [1/4] فحص وجود بيئة التشغيل Node.js...
where node >nul 2>&1
if errorlevel 1 goto ERROR_NO_NODE

echo [√] بيئة Node.js متوفرة وجاهزة:
node --version
echo.

REM --- خطوة 2: تثبيت الحزم المطلوبة ---
echo [2/4] جاري فحص وتثبيت مكتبات المشروع (Dependencies)...
if exist "node_modules" goto BUILD_APP

call npm install
if errorlevel 1 goto ERROR_NPM

:BUILD_APP
echo [√] المكتبات جاهزة ومكتملة.
echo.

REM --- خطوة 3: تجميع وبرمجة التطبيق ---
echo [3/4] جاري تجميع وبرمجة واجهات التطبيق (Vite Production Build)...
call npm run build
if errorlevel 1 (
    if exist "dist\index.html" (
        echo [√] تم العثور على ملفات التجميع الجاهزة مسبقا، جاري المتابعة مباشرة...
    ) else (
        goto ERROR_BUILD
    )
) else (
    echo [√] تم تجميع التطبيق بنجاح.
)
echo.

REM --- خطوة 4: حزم وتوليد ملف EXE لنظام ويندوز ---
echo [4/4] جاري بناء وتغليف البرنامج لملف تثبيت ويندوز (.exe)...
echo قد يستغرق هذا بضع دقائق في المرة الأولى لتحميل حزم Electron...
echo.

call npx --yes electron-builder --win nsis --config.asar=false --config.extraMetadata.main=electron-main.cjs
if errorlevel 1 goto ERROR_PACKAGING

echo.
echo ===============================================================================
echo                     مبروك! تم بناء برنامج الديسكتوب بنجاح تام
echo ===============================================================================
echo ستجد ملف التثبيت (.exe) جاهزاً الآن داخل مجلد: dist-electron
echo جاري فتح مجلد البرنامج تلقائياً...
echo.
if exist "dist-electron" (
    start "" "%~dp0dist-electron"
) else (
    if exist "dist" start "" "%~dp0dist"
)
echo اضغط أي زر لإغلاق هذه النافذة...
pause >nul
exit /b 0

REM ===============================================================================
REM                            أقسام معالجة الأخطاء
REM ===============================================================================

:ERROR_ZIP
echo.
echo ===============================================================================
echo [خطأ]: يبدو أنك قمت بتشغيل الملف مباشرة من داخل الملف المضغوط (ZIP)!
echo ===============================================================================
echo الحل:
echo 1. اضغط كليك يمين على ملف الـ ZIP المحمل.
echo 2. اختر "استخراج الكل..." أو "Extract All".
echo 3. ادخل إلى المجلد المستخرج الجديد وشغل هذا الملف من داخله.
echo.
pause
exit /b 1

:ERROR_NO_NODE
echo.
echo ===============================================================================
echo [تنبيه هام]: برنامج Node.js غير مثبت على جهاز الكمبيوتر الخاص بك!
echo ===============================================================================
echo.
echo سبب إغلاق الشاشة بسرعة سابقاً هو أن نظام ويندوز لم يعثر على أداة (Node.js)
echo المسؤولة عن بناء وتجميع برامج الديسكتوب من الكود المصدري.
echo.
echo الحل النهائي والبسيط جداً (يتم لمرة واحدة فقط):
echo --------------------------------------------------
echo 1. قم بتحميل وتثبيت برنامج Node.js المجاني (نسخة LTS) من الرابط:
echo    https://nodejs.org
echo.
echo 2. بعد اكتمال التثبيت، أعد تشغيل هذا الملف (build-exe.bat) وسيعمل تلقائياً!
echo.
set /p OPEN_URL="هل تريد فتح صفحة تحميل Node.js في المتصفح الآن؟ (Y/N): "
if /i "!OPEN_URL!"=="Y" (
    start https://nodejs.org
)
echo.
echo اضغط أي زر للخروج بعد قراءة التعليمات...
pause >nul
exit /b 1

:ERROR_NPM
echo.
echo ===============================================================================
echo [خطأ]: فشل تثبيت المكتبات عبر npm install!
echo ===============================================================================
echo يرجى التأكد من اتصال جهازك بالإنترنت أثناء البناء والمحاولة مجدداً.
echo.
pause
exit /b 1

:ERROR_BUILD
echo.
echo ===============================================================================
echo [خطأ]: فشل تجميع ملفات المشروع (npm run build)!
echo ===============================================================================
echo.
pause
exit /b 1

:ERROR_PACKAGING
echo.
echo ===============================================================================
echo [خطأ]: حدث خطأ أثناء تغليف ملف الـ EXE بواسطة Electron!
echo ===============================================================================
echo تأكد من اتصال الإنترنت لتنزيل نواة Electron ومحاولة التشغيل كمسؤول (Run as administrator).
echo.
pause
exit /b 1
