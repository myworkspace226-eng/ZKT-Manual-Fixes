@echo off
chcp 65001 >nul
cd /d "%~dp0"
title تشغيل برنامج البصمة ZKT Biometric

cls
echo ===============================================================================
echo            تشغيل برنامج البصمة كشاشة ديسكتوب مستقلة فوراً
echo ===============================================================================
echo.

where node >nul 2>&1
if errorlevel 1 goto NO_NODE

if not exist "node_modules" (
    echo [1/2] جاري تجهيز المكتبات للمرة الأولى...
    call npm install
)

echo [2/2] جاري تشغيل البرنامج وفتح نافذة الديسكتوب...
start "" msedge --app=http://localhost:3000 --window-size=1400,900
call npm run dev
pause
exit /b 0

:NO_NODE
echo ===============================================================================
echo [تنبيه]: يلزم تثبيت Node.js لتشغيل البرنامج محلياً.
echo الرابط: https://nodejs.org
echo ===============================================================================
pause
